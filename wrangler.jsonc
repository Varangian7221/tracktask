{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskflow-mvp",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "tracktask.okorsh.site",
      "custom_domain": true
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application"
  }
}
